@model BloodDonationManagementSystem.EF.Tables.Donor

@{
    ViewData["Title"] = "Donor Details";
}

<h2>Donor Details</h2>

<table class="table table-bordered">
    
    <tr>
        <th>Donor ID</th>
        <td>@Model.DonorId</td>
    </tr>

    <tr>
        <th>Full Name</th>
        <td>@Model.FullName</td>
    </tr>

    <tr>
        <th>Blood Group</th>
        <td>@Model.BloodGroup</td>
    </tr>

    <tr>
        <th>Contact Number</th>
        <td>@Model.ContactNo</td>
    </tr>

    <tr>
        <th>City</th>
        <td>@Model.City</td>
    </tr>

    <tr>
        <th>Last Donation Date</th>
        <td>
            @if (Model.LastDonationDate.HasValue)
            {
                @Model.LastDonationDate.Value.ToString("MMMM dd, yyyy")
            }
            else
            {
                <span>Not available</span>
            }
        </td>
    </tr>
</table>
<br />
<h3>Edit Details </h3>
<a href="/Donor/Edit/@Model.DonorId" class="btn btn-primary">Edit</a>
<br />
<h3>Back To Donors List </h3>
<a href="/Donor/Index" class="btn btn-secondary">Back</a>