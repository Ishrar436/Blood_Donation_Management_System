@model BloodDonationManagementSystem.EF.Tables.Donor

@{
    ViewData["Title"] = "Delete Donor";
}

<h2>Delete Donor</h2>

<p>
    Are you sure you want to delete this donor?
</p>

<table class="table table-bordered">
    <tr>
        <th>Donor ID</th>
        <td>@Model.DonorId</td>
    </tr>

    <tr>
        <th>Full Name</th>
        <td>@Model.FullName</td>
    </tr>

    <tr>
        <th>Blood Group</th>
        <td>@Model.BloodGroup</td>
    </tr>

    <tr>
        <th>Contact Number</th>
        <td>@Model.ContactNo</td>
    </tr>

    <tr>
        <th>City</th>
        <td>@Model.City</td>
    </tr>
</table>

<form action="/Donor/DeleteConfirmed" method="post">

    <input type="hidden" name="id" value="@Model.DonorId" />

    <input type="submit" value="Confirm Delete" class="btn btn-danger" />

    <a href="/Donor/Index" class="btn btn-secondary"> Cancel </a>
</form>