@model List<BloodDonationManagementSystem.EF.Tables.Donor>

@{
    ViewData["Title"] = "Filter Donors";
}

<h2>Filter Donors by Blood Group</h2>

<form action="/Donor/FilterByBloodGroup" method="get">

    <label for="bloodGroup"> Select Blood Group </label>

    <select name="bloodGroup" id="bloodGroup" class="form-control">

        <option value="">
            -- Select Blood Group --
        </option>

        <option value="A+">A+</option>
        <option value="A-">A-</option>
        <option value="B+">B+</option>
        <option value="B-">B-</option>
        <option value="AB+">AB+</option>
        <option value="AB-">AB-</option>
        <option value="O+">O+</option>
        <option value="O-">O-</option>
    </select>

    <br />

    <input type="submit" value="Filter" class="btn btn-primary" />
</form>

<br />

@if (!string.IsNullOrEmpty(ViewBag.SelectedBloodGroup))
{
    <h3>
        Donors with Blood Group:
        @ViewBag.SelectedBloodGroup
    </h3>

    @if (Model.Count != 0)
    {
        <table class="table table-bordered">

            <tr>
                <th>Donor ID</th>
                <th>Full Name</th>
                <th>Blood Group</th>
                <th>Contact Number</th>
                <th>City</th>
                <th>Last Donation Date</th>
            </tr>

            @foreach (var donor in Model)
            {
                <tr>
                    <td>@donor.DonorId</td>
                    <td>@donor.FullName</td>
                    <td>@donor.BloodGroup</td>
                    <td>@donor.ContactNo</td>
                    <td>@donor.City</td>

                    <td>
                        @if (donor.LastDonationDate.HasValue)
                        {
                            @donor.LastDonationDate.Value.ToString("MMMM dd, yyyy")
                        }
                        else
                        {
                            <span>Not available</span>
                        }
                    </td>
                </tr>
            }
            
        </table>
    }
    else
    {
        <h4>
            No donors found with this blood group.
        </h4>
    }
}

<br />

<a href="/Donor/Index" class="btn btn-secondary"> Back to Donor List </a>