@model IEnumerable<BloodDonationManagementSystem.Models.Donor>
@{
    ViewData["Title"] = "Filter Donors";
    var bloodGroups = ViewBag.BloodGroups as List<string> ?? new List<string>();
    string? selectedGroup = ViewBag.SelectedBloodGroup as string;
}

<h2>LINQ 1: Filter Donors by Blood Group</h2>

<form method="get" action="@Url.Action("FilterByBloodGroup", "Linq")">
    <label for="bloodGroup">Blood Group</label>
    <select id="bloodGroup" name="bloodGroup">
        <option value="">All Blood Groups</option>
        @foreach (var group in bloodGroups)
        {
            if (selectedGroup == group)
            {
                <option value="@group" selected>@group</option>
            }
            else
            {
                <option value="@group">@group</option>
            }
        }
    </select>
    <button type="submit">Filter</button>
</form>

<table>
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Blood Group</th>
            <th>Contact No</th>
            <th>City</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var donor in Model)
    {
        <tr>
            <td>@donor.FullName</td>
            <td>@donor.BloodGroup</td>
            <td>@donor.ContactNo</td>
            <td>@donor.City</td>
        </tr>
    }
    </tbody>
</table>
