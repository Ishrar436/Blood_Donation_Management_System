@model IEnumerable<BloodDonationManagementSystem.Models.Donor>
@{
    ViewData["Title"] = "Sorted Donors";
}

<h2>LINQ 2: Donors Sorted by Last Donation Date</h2>
<p>Most recent date appears first.</p>

<table>
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Blood Group</th>
            <th>Last Donation Date</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var donor in Model)
    {
        <tr>
            <td>@donor.FullName</td>
            <td>@donor.BloodGroup</td>
            <td>@(donor.LastDonationDate?.ToString("dd MMM yyyy") ?? "Never")</td>
        </tr>
    }
    </tbody>
</table>
