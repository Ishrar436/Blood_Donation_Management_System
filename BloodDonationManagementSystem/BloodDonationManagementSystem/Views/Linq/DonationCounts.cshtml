@model IEnumerable<BloodDonationManagementSystem.ViewModels.DonorDonationCountViewModel>
@{
    ViewData["Title"] = "Donation Counts";
}

<h2>LINQ 3: Total Donations for Each Donor</h2>

<table>
    <thead>
        <tr>
            <th>Donor ID</th>
            <th>Full Name</th>
            <th>Blood Group</th>
            <th>Total Donations</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.DonorId</td>
            <td>@item.FullName</td>
            <td>@item.BloodGroup</td>
            <td>@item.TotalDonations</td>
        </tr>
    }
    </tbody>
</table>
