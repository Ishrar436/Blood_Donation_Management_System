@model BloodDonationManagementSystem.Models.Donor
@{
    ViewData["Title"] = "Delete Donor";
}

<h2>Delete Donor</h2>
<h3>Are you sure you want to delete this donor?</h3>
<dl>
    <dt>Full Name</dt><dd>@Model.FullName</dd>
    <dt>Blood Group</dt><dd>@Model.BloodGroup</dd>
    <dt>Contact No</dt><dd>@Model.ContactNo</dd>
    <dt>City</dt><dd>@Model.City</dd>
</dl>

<form method="post" action="@Url.Action("Delete", "Donors", new { id = Model.DonorId })">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.DonorId" />
    <button type="submit">Delete</button>
    <a href="@Url.Action("Index", "Donors")">Back to List</a>
</form>
