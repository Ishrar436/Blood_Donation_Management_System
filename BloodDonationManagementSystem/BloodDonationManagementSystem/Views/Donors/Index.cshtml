@model BloodDonationManagementSystem.Models.Donor
@{
    ViewData["Title"] = "Donors";
}

<h2>Donor List</h2>
<p><a class="button" href="@Url.Action("Create", "Donors")">Create New Donor</a></p>

<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Full Name</th>
            <th>Blood Group</th>
            <th>Contact No</th>
            <th>City</th>
            <th>Last Donation Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var donor in Model)
    {
        <tr>
            <td>@donor.DonorId</td>
            <td>@donor.FullName</td>
            <td>@donor.BloodGroup</td>
            <td>@donor.ContactNo</td>
            <td>@donor.City</td>
            <td>@(donor.LastDonationDate?.ToString("dd MMM yyyy") ?? "Not donated")</td>
            <td>
                <a href="@Url.Action("Details", "Donors", new { id = donor.DonorId })">Details</a> |
                <a href="@Url.Action("Edit", "Donors", new { id = donor.DonorId })">Edit</a> |
                <a href="@Url.Action("Delete", "Donors", new { id = donor.DonorId })">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
