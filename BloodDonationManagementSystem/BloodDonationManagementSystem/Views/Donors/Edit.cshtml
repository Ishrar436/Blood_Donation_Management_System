@model BloodDonationManagementSystem.Models.Donor
@{
    ViewData["Title"] = "Edit Donor";
    string[] groups = { "A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-" };
}

<h2>Edit Donor</h2>

<form method="post" action="@Url.Action("Edit", "Donors", new { id = Model.DonorId })" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" name="DonorId" value="@Model.DonorId" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="validation-summary">Please correct the errors below.</div>
    }

    <div class="form-group">
        <label for="FullName">Full Name</label>
        <input id="FullName" name="FullName" type="text" value="@Model.FullName" />
        @if (ViewData.ModelState["FullName"]?.Errors.Count > 0)
        {
            <span class="error">@ViewData.ModelState["FullName"]!.Errors[0].ErrorMessage</span>
        }
    </div>

    <div class="form-group">
        <label for="BloodGroup">Blood Group</label>
        <select id="BloodGroup" name="BloodGroup">
            <option value="">-- Select --</option>
            @foreach (string group in groups)
            {
                if (Model.BloodGroup == group)
                {
                    <option value="@group" selected>@group</option>
                }
                else
                {
                    <option value="@group">@group</option>
                }
            }
        </select>
        @if (ViewData.ModelState["BloodGroup"]?.Errors.Count > 0)
        {
            <span class="error">@ViewData.ModelState["BloodGroup"]!.Errors[0].ErrorMessage</span>
        }
    </div>

    <div class="form-group">
        <label for="ContactNo">Contact No</label>
        <input id="ContactNo" name="ContactNo" type="text" value="@Model.ContactNo" />
        @if (ViewData.ModelState["ContactNo"]?.Errors.Count > 0)
        {
            <span class="error">@ViewData.ModelState["ContactNo"]!.Errors[0].ErrorMessage</span>
        }
    </div>

    <div class="form-group">
        <label for="City">City</label>
        <input id="City" name="City" type="text" value="@Model.City" />
        @if (ViewData.ModelState["City"]?.Errors.Count > 0)
        {
            <span class="error">@ViewData.ModelState["City"]!.Errors[0].ErrorMessage</span>
        }
    </div>

    <div class="form-group">
        <label for="LastDonationDate">Last Donation Date</label>
        <input id="LastDonationDate" name="LastDonationDate" type="date"
               value="@(Model.LastDonationDate?.ToString("yyyy-MM-dd"))" />
        @if (ViewData.ModelState["LastDonationDate"]?.Errors.Count > 0)
        {
            <span class="error">@ViewData.ModelState["LastDonationDate"]!.Errors[0].ErrorMessage</span>
        }
    </div>

    <button type="submit">Save</button>
    <a href="@Url.Action("Index", "Donors")">Back to List</a>
</form>
